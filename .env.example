# LLM Provider Configuration
# Which provider to use: gemini | openai | claude
LLM_PROVIDER=gemini

# API Keys (only the key for your chosen provider is required)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SMTP Configuration (Provider: Gmail, Outlook, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="PulseHQ"
# Optional blind copy on every send (omit for OSS / privacy)
SMTP_BCC=
